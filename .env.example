# ============================================================
# .env.example — copie para .env e ajuste os valores
# ============================================================

# ─── Banco de dados ──────────────────────────────────────────
# Perfil dev  → aponta para o PostgreSQL (via docker-compose ou local)
# Perfil test → ignorado (usa H2 in-memory automaticamente)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pokerbank_dev?ssl=false
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ─── Perfil ativo ────────────────────────────────────────────
# Opcoes: dev | test
SPRING_PROFILES_ACTIVE=dev

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET_PASSWORD=troque_por_uma_string_longa_e_aleatoria_de_pelo_menos_64_chars
JWT_EXPIRATION_TIME=1440
JWT_REFRESH_EXPIRATION_TIME=7

# ─── Email (SMTP) ────────────────────────────────────────────
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=seu_email@gmail.com
SPRING_MAIL_PASSWORD=app_password_do_gmail

# ─── Servidor ────────────────────────────────────────────────
SERVER_PORT=7070

# ─── Frontend ────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173
